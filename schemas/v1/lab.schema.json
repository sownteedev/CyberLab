{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CyberLab Lab definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "nodes", "networks"],
  "properties": {
    "apiVersion": {"const": "cyberlab.ptit/v1"},
    "kind": {"const": "Lab"},
    "documentation": {"type": "string", "minLength": 1, "maxLength": 200},
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "master_seed": {"type": "string", "minLength": 1, "maxLength": 128},
        "host_home_xfer": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*(/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"},
        "grade_node": {"$ref": "#/$defs/identifier"},
        "collect_documentation": {"type": "boolean"},
        "checkwork": {"type": "boolean"}
      }
    },
    "parameters": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "type": {"enum": ["text", "integer", "boolean", "choice"]},
          "default": {"type": ["string", "integer", "boolean"], "maxLength": 1024, "minimum": -2147483648, "maximum": 2147483647},
          "choices": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
          "description": {"type": "string", "maxLength": 512},
          "public": {"type": "boolean"}
        }
      }
    },
    "parameterizations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "operation", "node", "path"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "operation": {"enum": ["rand_replace", "rand_replace_unique", "hash_replace", "hash_create", "clone_replace"]},
          "node": {"$ref": "#/$defs/identifier"},
          "path": {"$ref": "#/$defs/workspacePath"},
          "targets": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": ["node", "path"],
              "additionalProperties": false,
              "properties": {
                "node": {"$ref": "#/$defs/identifier"},
                "path": {"$ref": "#/$defs/workspacePath"}
              }
            }
          },
          "token": {"type": "string", "minLength": 1, "maxLength": 128},
          "value": {"type": "string", "maxLength": 1024},
          "lower": {"type": "integer", "minimum": 0, "maximum": 2147483647},
          "upper": {"type": "integer", "minimum": 0, "maximum": 2147483647},
          "step": {"type": "integer", "minimum": 1, "maximum": 2147483647}
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "node", "path"],
            "properties": {
              "id": {"$ref": "#/$defs/identifier"},
              "node": {"$ref": "#/$defs/identifier"},
              "path": {"$ref": "#/$defs/workspacePath"},
              "label": {"type": "string", "maxLength": 128},
              "required": {"type": "boolean"}
            }
          }
        },
        "results": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "node", "path", "operator"],
            "properties": {
              "id": {"$ref": "#/$defs/identifier"},
              "node": {"$ref": "#/$defs/identifier"},
              "path": {"$ref": "#/$defs/workspacePath"},
              "operator": {"enum": ["exists", "contains", "equals", "line_contains", "regex", "size_less_than", "size_equals", "line_count_equals", "sha256_equals", "md5_equals", "string_count_equals", "field_equals"]},
              "expected": {"type": ["string", "integer"], "maxLength": 4096, "minimum": 0, "maximum": 16777216},
              "description": {"type": "string", "maxLength": 256},
              "hint": {"type": "string", "maxLength": 512},
              "field_type": {"enum": ["token", "parens", "quotes", "slash", "group"]},
              "field_id": {"type": ["string", "integer"], "maxLength": 256, "minimum": 0, "maximum": 4096},
              "line_type": {"enum": ["line", "starts_with", "contains", "regex", "previous_starts_with"]},
              "line_id": {"type": ["string", "integer"], "maxLength": 4096, "minimum": 1, "maximum": 1048576}
            }
          }
        },
        "goals": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": {"$ref": "#/$defs/identifier"},
              "results": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
              "mode": {"enum": ["all", "any"]},
              "description": {"type": "string", "maxLength": 256},
              "type": {"enum": ["group", "compare", "count", "boolean"]},
              "operator": {"enum": ["string_equal", "string_diff", "string_contains", "string_start", "string_end", "integer_equal", "integer_greater", "integer_less", "hash_equal", "count_greater"]},
              "result": {"$ref": "#/$defs/identifier"},
              "other": {"$ref": "#/$defs/identifier"},
              "expected": {"type": ["string", "integer"], "maxLength": 4096},
              "threshold": {"type": "integer", "minimum": 0, "maximum": 64},
              "expression": {"type": "string", "maxLength": 512}
            }
          }
        }
      }
    },
    "quiz": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/quizItem"}
    },
    "quizzes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "items"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "title": {"type": "string", "maxLength": 128},
          "pre_start": {"type": "boolean"},
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {"$ref": "#/$defs/quizItem"}
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?![\\s\\S])"}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "networks"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "hostname": {"type": "string", "minLength": 1, "maxLength": 63, "oneOf": [
            {"pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
            {"pattern": "^(?:\\{\\{param:[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\}\\}|\\$\\{PARAM:[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\})$"}
          ]},
          "terminal_group": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_.-]+$"},
          "terminal_title": {"type": "string", "minLength": 1, "maxLength": 128},
          "aliases": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
          "wait_for": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
          "resources": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "memory_mb": {"type": "integer", "minimum": 64, "maximum": 512},
              "cpu_millicores": {"type": "integer", "minimum": 100, "maximum": 1000}
            }
          },
          "extra_hosts": {
            "type": "object", "maxProperties": 8,
            "propertyNames": {"pattern": "^[a-z][a-z0-9.-]{0,62}$"},
            "additionalProperties": {"type": "string", "pattern": "^[0-9]{1,3}(?:\\.[0-9]{1,3}){3}$"}
          },
          "terminal_count": {"type": "integer", "minimum": 1, "maximum": 4},
          "clone": {"type": "integer", "minimum": 1, "maximum": 4},
          "addresses": {
            "type": "object", "maxProperties": 4,
            "propertyNames": {"$ref": "#/$defs/identifier"},
            "additionalProperties": {"type": "string", "minLength": 7, "maxLength": 64}
          },
          "dns": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 7, "maxLength": 15}},
          "user": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "uid", "gid", "home", "shell"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 32},
              "uid": {"type": "integer", "minimum": 1000, "maximum": 60000},
              "gid": {"type": "integer", "minimum": 1000, "maximum": 60000},
              "home": {"type": "string", "minLength": 1, "maxLength": 38},
              "shell": {"enum": ["/bin/sh", "/bin/bash"]}
            }
          },
          "image": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/:@-]*(?![\\s\\S])"},
          "files": {
            "type": "array", "maxItems": 16,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["source", "target"],
              "properties": {
                "source": {"type": "string", "minLength": 1, "maxLength": 200},
                "target": {"type": "string", "minLength": 1, "maxLength": 200, "description": "Workspace-relative destination; '.' copies a directory's contents directly into the workspace. Other dot components and traversal are forbidden."}
              }
            }
          },
          "command": {
            "type": "array", "minItems": 1, "maxItems": 32,
            "items": {"type": "string", "minLength": 1, "maxLength": 1024, "not": {"pattern": "\\u0000"}}
          },
          "networks": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/identifier"}
          }
        }
      }
    },
    "terminals": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "networks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "subnet": {"type": "string", "minLength": 9, "maxLength": 64},
          "gateway": {"type": "string", "minLength": 7, "maxLength": 64}
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(?![\\s\\S])"
    },
    "workspacePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
    },
    "quizItem": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "text", "type"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "type": {"const": "preface"},
            "text": {"type": "string", "minLength": 1, "maxLength": 1024}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "question", "options"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "type": {"enum": ["choice"]},
            "question": {"type": "string", "minLength": 1, "maxLength": 512},
            "options": {"type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
            "answer": {"type": "integer", "minimum": 0, "maximum": 7},
            "explanation": {"type": "string", "maxLength": 512},
            "right_response": {"type": "string", "maxLength": 512},
            "wrong_response": {"type": "string", "maxLength": 512},
            "prerequisite": {"$ref": "#/$defs/identifier"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "question", "type"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "type": {"const": "true_false"},
            "question": {"type": "string", "minLength": 1, "maxLength": 512},
            "answer": {"type": "boolean"},
            "explanation": {"type": "string", "maxLength": 512},
            "right_response": {"type": "string", "maxLength": 512},
            "wrong_response": {"type": "string", "maxLength": 512},
            "prerequisite": {"$ref": "#/$defs/identifier"}
          }
        }
      ]
    }
  }
}
